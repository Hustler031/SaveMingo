NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Google Analytics 4 Measurement ID, for example G-XXXXXXXXXX.
# Leave unset during development if analytics is not connected.
# NEXT_PUBLIC_GA_ID=

# Optional Google Search Console HTML/meta verification token.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional Instagram resolver maintenance override.
# The app has a built-in current default; set this only when Instagram rotates
# its anonymous web GraphQL query document ID.
# INSTAGRAM_GRAPHQL_DOC_ID=

# Optional error monitoring. Configure only after creating a Sentry project.
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Future integrations (never commit real values):
# RESOLVER_BASE_URL=
# RESOLVER_API_KEY=
