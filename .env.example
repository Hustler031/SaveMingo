NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Google Analytics 4 override.
# Production currently falls back to SaveMingo's public Measurement ID:
# G-ZXK1PRVH6X
# NEXT_PUBLIC_GA_ID=G-ZXK1PRVH6X

# Optional Google Search Console HTML/meta verification token.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional Instagram resolver maintenance override.
# The app has a built-in current default; set this only when Instagram rotates
# its anonymous web GraphQL query document ID.
# INSTAGRAM_GRAPHQL_DOC_ID=

# Optional error monitoring. Configure only after creating a Sentry project.
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Future integrations (never commit real values):
# RESOLVER_BASE_URL=
# RESOLVER_API_KEY=

# Optional Pinterest API access. Obtain through an approved Pinterest developer
# app and keep the real token only in local/hosting secrets.
# PINTEREST_ACCESS_TOKEN=
